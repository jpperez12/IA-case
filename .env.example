# Proveedor del modelo. Si se deja vacío, se usa el que tenga clave configurada.
#   gemini    → Google Gemini (nivel gratuito; clave en aistudio.google.com)
#   anthropic → Claude (pago por uso; clave en console.anthropic.com)
LLM_PROVIDER=
# Modelo. Por defecto: gemini-flash-latest (gemini) o claude-sonnet-4-6 (anthropic).
LLM_MODEL=

# Claves del modelo: SOLO aquí (o en las variables del servicio de hosting). Nunca en el repositorio.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Protección del link público: si se define, el front la pide y la API la exige (cabecera x-access-key).
ACCESS_KEY=

# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=60000

PORT=3000
