# Proveedor y modelo de lenguaje
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
# Clave del modelo: SOLO aquí (o en las variables del servicio de hosting). Nunca en el repositorio.
ANTHROPIC_API_KEY=

# Protección del link público: si se define, el front la pide y la API la exige (cabecera x-access-key).
ACCESS_KEY=

# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=60000

PORT=3000
